# Network stack choices for running the phone as an always-on server.
# Runtime knobs: net.ipv4.tcp_congestion_control, net.core.default_qdisc.

# BBR as the default TCP congestion control instead of the official BIC
# (bic and cubic stay available). Since v4.13 TCP paces BBR flows itself, so
# it does not depend on the fq qdisc.
CONFIG_TCP_CONG_BBR=y
# CONFIG_DEFAULT_BIC is not set
CONFIG_DEFAULT_BBR=y

# fq_codel as the default qdisc instead of pfifo_fast: keeps queueing delay
# low under load, including for traffic the phone forwards as a router or
# for its containers. fq is built too for those who prefer it with BBR.
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
