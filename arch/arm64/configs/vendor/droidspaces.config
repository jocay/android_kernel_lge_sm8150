# Droidspaces container support, following the upstream "non-GKI" option list
# (Documentation/Kernel-Configuration.md in ravindu644/Droidspaces-OSS, v6.6.0).
# Only what the official config lacks is listed; the rest of that list
# (namespaces, seccomp, memcg, overlayfs, veth, bridge, NAT, tmpfs xattr/ACL,
# ...) is already enabled. Not available on 4.14 and therefore left out:
# FW_LOADER_COMPRESS, NETFILTER_XT_TARGET_MASQUERADE and
# NETFILTER_XT_TARGET_REJECT (IP_NF_TARGET_MASQUERADE / IP_NF_TARGET_REJECT
# are on), IP_NF_TARGET_ULOG; NF_CONNTRACK_NETLINK is NF_CT_NETLINK here and
# on. Of the two upstream patches only the cgroup one applies
# (kernel/cgroup/cgroup.c); this tree has no xt_qtaguid.
#
# Several of these options (SYSVIPC, POSIX_MQUEUE, CGROUP_*, USER_NS) grow
# core structs, so the kernel is no longer ABI compatible with the modules in
# the official vendor image.

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_PID_NS=y
CONFIG_IPC_NS=y

# Control groups
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_NET_PRIO=y

# /dev for containers. DEVTMPFS_MOUNT stays off: Android's init owns /dev.
CONFIG_DEVTMPFS=y

# NAT mode. br_netfilter is a module in the official build; that module is
# not loadable on a rebuilt kernel, so it is built in.
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# UFW inside containers
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban inside containers
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# User namespaces, for Docker inside a container (avoids its "unsafe procfs"
# error). Optional for Droidspaces itself. Note the cost: every unprivileged
# Android app can create user namespaces too, which Android kernels normally
# keep disabled to limit kernel attack surface. Drop this line if you do not
# need it.
CONFIG_USER_NS=y
